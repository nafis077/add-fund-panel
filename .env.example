# Local SQLite
DATABASE_URL="file:./dev.db"

# Railway: add a Postgres plugin, then reference DATABASE_URL on the web service.
# DATABASE_PRIVATE_URL and PGHOST/PGUSER/PGPASSWORD/PGDATABASE are also accepted.
# If none are set, Railway boot falls back to SQLite (data is lost on redeploy).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway"

AUTH_SECRET="replace-with-a-long-random-secret"
ENCRYPTION_KEY="replace-with-64-hex-chars-or-32-byte-passphrase"
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="ChangeMeNow!"
ADMIN_NAME="Treasury Admin"
NEXT_PUBLIC_APP_NAME="Panel Treasury"
WORKER_POLL_MS="750"
PAYMENT_TIMEOUT_MS="15000"
