{
  "name": "add-fund-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Centralized multi-panel fund management for SMM X PANEL Admin API v2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:railway": "node scripts/railway-start.mjs",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate --schema=prisma/schema.prisma && prisma db push --schema=prisma/schema.prisma && tsx prisma/seed.ts",
    "worker": "tsx src/worker.ts",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "bcryptjs": "^3.0.2",
    "decimal.js": "^10.5.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.503.0",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
